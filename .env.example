# Ableton Helper — настройки. Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в git не попадает (.gitignore). Переменные окружения имеют приоритет над .env.

# Ключ Anthropic API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модель и глубина размышлений (low | medium | high | xhigh | max)
# ABHELPER_MODEL=claude-opus-5-5
# ABHELPER_EFFORT=medium

# Порты: мост Remote Script в Live и веб-сервер чата
# ABHELPER_BRIDGE_PORT=9888
# ABHELPER_PORT=8765

# Папка для файлов программы (настройки из чата, каталог калибровки). По умолчанию ~/.ableton-helper
# ABHELPER_HOME=D:\Ableton\ableton-helper
